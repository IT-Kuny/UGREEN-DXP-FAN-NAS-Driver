[Unit]
Description=Load IT87 hardware monitoring driver
DefaultDependencies=no
Before=ugreen-fan-control.service
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/sbin/depmod -a
# Optional on purpose: succeeds on module systems, is harmless when built-in.
ExecStartPre=-/sbin/modprobe hwmon-vid
ExecStart=/bin/sh -c 'if grep -q "^vendor_id.*AuthenticAMD" /proc/cpuinfo 2>/dev/null; then /sbin/modprobe it87; else /sbin/modprobe it87 ignore_resource_conflict=1; fi'
ExecStop=-/sbin/modprobe -r it87

[Install]
WantedBy=multi-user.target
