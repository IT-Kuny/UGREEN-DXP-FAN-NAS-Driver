# UGREEN Fan Control Configuration
# Loaded by ugreen-fan-control.service as an EnvironmentFile.
# Edit this file, then: sudo systemctl restart ugreen-fan-control.service

# How often (in seconds) to poll temperatures and update the fan.
POLL_INTERVAL=10

# PWM value applied immediately when a sensor read failure occurs.
FAILSAFE_PWM=200

# Hard floor and ceiling for all calculated PWM values.
MIN_PWM=50
MAX_PWM=255

# Which curve preset to use: silent, normal, or powerful.
# silent   — quietest; tolerates higher temps before spinning up.
# normal   — balanced default.
# powerful — spins up earlier/harder for maximum cooling.
FAN_MODE=normal

# --- Balanced curves (FAN_MODE=normal) ---
CPU_FAN_CURVE=35:50,50:100,65:180,75:255
DISK_FAN_CURVE=35:60,45:110,55:180,60:255

# --- Quiet curves (FAN_MODE=silent) ---
# Note: MIN_PWM still acts as a floor; lower it too if you want the fan to
# idle near 0 RPM below the first curve point.
SILENT_CPU_FAN_CURVE=40:0,55:40,65:80,75:150
SILENT_DISK_FAN_CURVE=38:0,45:40,55:80,62:150

# --- Aggressive curves (FAN_MODE=powerful) ---
POWERFUL_CPU_FAN_CURVE=30:120,45:180,55:220,65:255
POWERFUL_DISK_FAN_CURVE=30:120,40:180,50:220,55:255

# --- Optional overrides ---
# Uncomment and set to bypass auto-detection of the PWM sysfs path.
# FAN_PWM_PATH=/sys/class/hwmon/hwmon3/pwm3

# Uncomment and set to read CPU temperature from a specific sysfs file.
# CPU_TEMP_PATH=/sys/class/hwmon/hwmon0/temp1_input

# Set to 1 to enable verbose debug logging.
# FAN_DEBUG=0
